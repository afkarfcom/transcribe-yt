# Both are OPTIONAL. Fill them in only if YouTube blocks your Vercel server
# (error: "YouTube memblokir request dari server ini").

# 1) HTTP(S) proxy for all requests to YouTube (a residential proxy works best).
#    Example: http://user:pass@proxy.example.com:8080
TRANSCRIPT_PROXY_URL=

# 2) Cookie header from a logged-in YouTube session (preferably a secondary account).
#    Example: SID=...; HSID=...; SSID=...; APISID=...; SAPISID=...; __Secure-3PSID=...
YOUTUBE_COOKIE=
